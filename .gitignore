# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large Datasets (keep raw PCAP/large CSVs out of Git)
data/raw/*.csv
data/raw/*.pcap
data/processed/*.csv
!data/sample/*.csv

# Trained large model artifacts (except lightweight metadata)
models/saved_models/*.joblib
!models/saved_models/.gitkeep
models/model_metadata/*.json
!models/model_metadata/.gitkeep

# Pytest / coverage cache
.pytest_cache/
.coverage
htmlcov/

# Logs and temporary execution outputs
*.log
scratch/

